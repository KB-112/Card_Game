  dialogueLines:
  - status: New_Game
    dialogue:
    - "Ah, a new soul arrives... I\u2019ve been expecting you"
    - The path ahead is treacherous, yet glorious. Will you brave the journey?
  - status: Previous_Game
    dialogue:
    - Welcome back, traveler. The cards remember your touch.
    - Would you like to continue your journey or begin anew?
  - status: Restart_Game
    dialogue:
    - Hmm... the last card has fallen, and the tide has turned against you.
    - Even the wisest must sometimes begin a new.
    - Shall we try again, brave one?
  typingSpeed: 0.03
  nextLineDelay: 0.5
  playOnStart: 1
  startStatus: Restart_Game
